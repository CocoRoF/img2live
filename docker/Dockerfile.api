# img2live API: upload validation, safety gate (CPU, onnxruntime), job queue, file serving. No GPU, no torch.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    IMG2LIVE_DATA=/data HF_HOME=/data/models/hf-home XDG_CACHE_HOME=/tmp
WORKDIR /app
COPY docker/requirements-api.txt ./requirements.txt
RUN pip install -r requirements.txt
COPY pyproject.toml README.md LICENSE NOTICE ./
COPY src ./src
RUN pip install --no-deps . && python -c "import img2live, fastapi, onnxruntime, cv2, scipy; print('img2live', img2live.__version__)"
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4).status==200 else 1)"
CMD ["uvicorn", "img2live.server.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*"]
