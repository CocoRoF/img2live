# img2live GPU worker: LayerDiff3D decomposition + rig compiler. Needs an NVIDIA GPU (>= 12 GB for the default NF4 setup).
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    IMG2LIVE_DATA=/data HF_HOME=/data/models/hf-home XDG_CACHE_HOME=/tmp
WORKDIR /app
# torch first, from the CUDA 12.8 index (also supports Blackwell / sm_120)
RUN pip install --index-url https://download.pytorch.org/whl/cu128 torch==2.8.0 torchvision==0.23.0
COPY docker/requirements-worker.txt ./requirements.txt
RUN pip install -r requirements.txt
COPY pyproject.toml README.md LICENSE NOTICE ./
COPY src ./src
RUN pip install --no-deps . && python -c "import torch, diffusers, bitsandbytes, img2live; print(torch.__version__, diffusers.__version__)"
CMD ["python", "-m", "img2live.worker.main"]
