# Required: random string used to hash client IPs (never reuse across deployments)
IMG2LIVE_IP_SALT=change-me-to-a-long-random-string
# Where jobs, the database and model caches live (must be writable by IMG2LIVE_UID)
IMG2LIVE_DATA_DIR=/srv/img2live-data
IMG2LIVE_UID=1000
IMG2LIVE_GID=1000
IMG2LIVE_PORT=58600
# Optional invite code for the upload form (empty = open)
IMG2LIVE_ACCESS_CODE=
IMG2LIVE_PER_IP_PER_DAY=3
IMG2LIVE_MAX_QUEUE=8
IMG2LIVE_RETENTION_HOURS=72
# Behind a reverse proxy / Cloudflare tunnel: trust CF-Connecting-IP / X-Forwarded-For
IMG2LIVE_TRUST_PROXY=1
# Engine: layerdiff (GPU) | fake (synthetic character, no GPU — for trying the UI)
IMG2LIVE_ENGINE=layerdiff

# Resource caps for the GPU worker (the host is shared with other services)
# IMG2LIVE_WORKER_CPUS=4
# IMG2LIVE_WORKER_THREADS=4
# IMG2LIVE_WORKER_MEM=12g
